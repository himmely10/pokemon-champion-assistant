fect":"向对手发射强光， 并给予伤害。","moveTraits":["non-contact"]},{"id":707,"key":"stomping-tantrum","name":"跺脚","category":"physical","type":"ground","power":75,"accuracy":100,"pp":12,"priority":0,"target":"selected-pokemon","effect":"化悔恨为力量进行攻击。 如果上一回合招式没有打中， 威力就会翻倍。","moveTraits":["contact"]},{"id":797,"key":"expanding-force","name":"广域战力","category":"special","type":"psychic","power":80,"accuracy":100,"pp":12,"priority":0,"target":"selected-pokemon","effect":"利用精神力量攻击对手。 在精神场地上威力会有所提高， 能对所有对手造成伤害。","moveTraits":["non-contact"]},{"id":854,"key":"last-respects","name":"扫墓","category":"physical","type":"ghost","power":50,"accuracy":100,"pp":12,"priority":0,"target":"selected-pokemon","effect":"为了一雪同伴之耻而攻击。倒下的同伴越多，威力越大。","moveTraits":["non-contact"]}],"abilities":[{"id":8,"key":"sand-veil","name":"沙隐","description":"沙暴状态时， 闪避率会变为1.25倍。"},{"id":24,"key":"rough-skin","name":"粗糙皮肤","description":"受到接触类招式影响时， 会给予对手其最大HP的1/8的伤害。"}],"items":[{"id":287,"name":"讲究围巾","key":"choice-scarf","effect":"速度会变为1.5倍， 但一旦使出招式，直到替换为止 就会变得只能使出该招式。"},{"id":268,"name":"达人带","key":"expert-belt","effect":"使出的招式为效果绝佳时， 威力会变为1.2倍。"},{"id":275,"name":"气势披带","key":"focus-sash","effect":"HP全满时， 若受到会一击导致昏厥的招式的伤害， 则会剩下1HP并撑过去。 使用1次后就会在该次对战中消失。"},{"id":270,"name":"生命宝珠","key":"life-orb","effect":"招式的威力会变为1.3倍， 但每当成功使出攻击时， 都会减少最大HP的1/10。"},{"id":540,"name":"凸凸头盔","key":"rocky-helmet","effect":"让宝可梦携带后，在受到打击招式攻击时，能给予对手伤害。"},{"id":237,"name":"柔软沙子","key":"soft-sand","effect":"地面属性招式的威力会变为1.2倍。"},{"id":683,"name":"烈咬陆鲨进化石","key":"garchompite","effect":"能让烈咬陆鲨进行超级进化的持有物。 （超级烈咬陆鲨）"},{"id":2640,"name":"烈咬陆鲨进化石Z","key":"garchompite-z","effect":"能让烈咬陆鲨进行超级进化的持有物。 （超级烈咬陆鲨Z）"},{"id":686,"name":"洛玫果","key":"roseli-berry","effect":"受到效果绝佳的妖精属性招式影响时， 伤害会减半。 使用1次后就会在该次对战中消失。"},{"id":158,"name":"文柚果","key":"sitrus-berry","effect":"剩余HP变为最大HP的1/2以下时， 可以回复最大HP的1/4。 使用1次后就会在该次对战中消失。"}],"natures":[{"id":2,"name":"勇敢","increased":"attack","decreased":"speed"},{"id":3,"name":"固执","increased":"attack","decreased":"spAttack"},{"id":