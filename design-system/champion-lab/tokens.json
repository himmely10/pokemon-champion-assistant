{
  "$schema": "https://tr.designtokens.org/format/",
  "meta": {
    "name": "Champion Lab",
    "version": "1.0.0",
    "platform": "PySide6 desktop",
    "density": 8,
    "motion": 4,
    "variance": 7
  },
  "color": {
    "light": {
      "canvas": "#F3F6FA",
      "surface": "#FFFFFF",
      "surfaceMuted": "#EAF0F6",
      "surfaceStrong": "#DDE7F0",
      "ink": "#17243C",
      "textPrimary": "#14243A",
      "textSecondary": "#465A70",
      "textMuted": "#607389",
      "border": "#CBD7E3",
      "borderStrong": "#95A8BA",
      "trainer": "#246BCE",
      "trainerSoft": "#E7F0FD",
      "rival": "#D83A49",
      "rivalSoft": "#FDEBED",
      "spark": "#F4C430",
      "success": "#167A62",
      "warning": "#9A6500",
      "danger": "#B42332",
      "focus": "#1769D2"
    },
    "dark": {
      "canvas": "#0C1424",
      "surface": "#121D30",
      "surfaceMuted": "#1A2940",
      "surfaceStrong": "#22334C",
      "ink": "#08101D",
      "textPrimary": "#F4F7FB",
      "textSecondary": "#C0CCDA",
      "textMuted": "#93A6BB",
      "border": "#34475F",
      "borderStrong": "#58708C",
      "trainer": "#6EA8FF",
      "trainerSoft": "#17345E",
      "rival": "#FF7C87",
      "rivalSoft": "#53232C",
      "spark": "#FFD75A",
      "success": "#55D6B0",
      "warning": "#F3BC62",
      "danger": "#FF8791",
      "focus": "#8CBAFF"
    }
  },
  "space": {
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "5": 20,
    "6": 24,
    "8": 32,
    "10": 40,
    "12": 48,
    "16": 64
  },
  "radius": {
    "sm": 4,
    "md": 8,
    "lg": 12,
    "xl": 18,
    "pill": 999
  },
  "size": {
    "controlCompact": 36,
    "control": 40,
    "controlTouch": 44,
    "iconStatus": 16,
    "iconToolbar": 18,
    "iconDefault": 20,
    "iconNavigation": 22,
    "spriteRoster": 56,
    "spriteDetail": 88
  },
  "type": {
    "family": {
      "brand": "Bahnschrift SemiCondensed",
      "body": "Microsoft YaHei UI",
      "data": "Bahnschrift"
    },
    "display": { "size": 32, "lineHeight": 40, "weight": 700 },
    "hero": { "size": 28, "lineHeight": 36, "weight": 700 },
    "title": { "size": 22, "lineHeight": 30, "weight": 700 },
    "section": { "size": 17, "lineHeight": 25, "weight": 600 },
    "body": { "size": 14, "lineHeight": 22, "weight": 400 },
    "label": { "size": 13, "lineHeight": 19, "weight": 500 },
    "caption": { "size": 12, "lineHeight": 18, "weight": 400 },
    "dataLarge": { "size": 24, "lineHeight": 30, "weight": 600 },
    "dataMedium": { "size": 16, "lineHeight": 22, "weight": 600 }
  },
  "motion": {
    "instant": { "durationMs": 0, "easing": "linear" },
    "fast": { "durationMs": 100, "easing": "OutCubic" },
    "base": { "durationMs": 160, "easing": "OutCubic" },
    "emphasis": { "durationMs": 240, "easing": "OutCubic" },
    "scan": { "durationMs": 360, "easing": "InOutCubic", "staggerMs": 45 }
  },
  "layout": {
    "minimumWidth": 600,
    "minimumHeight": 480,
    "breakpoints": [600, 800, 1120, 1440],
    "navigationExpanded": 176,
    "navigationCompact": 72,
    "insightPanel": 320,
    "insightPanelCompact": 280
  }
}
